# Example environment variables (do not put secrets in git)

# Local client
LLAMA_BASE_URL=https://YOUR-RUNPOD-ENDPOINT/v1
LLAMA_API_KEY=local-key
SERVED_MODEL_NAME=local-gguf

# Optional Open WebUI
OPENAI_API_BASE_URL=https://YOUR-RUNPOD-ENDPOINT/v1
OPENAI_API_KEY=local-key
DEFAULT_MODELS=local-gguf

# Model settings (server container)
MODEL_PATH=/models/model.gguf
MODEL_URL=
HF_TOKEN=REPLACE_ME

# llama.cpp performance
LLAMA_CTX=8192
LLAMA_THREADS=32
LLAMA_MLOCK=1
LLAMA_NO_MMAP=0
LLAMA_EXTRA_ARGS=

# RunPod API
RUNPOD_API_KEY=REPLACE_ME
RUNPOD_API_BASE=https://rest.runpod.io/v1
RUNPOD_POD_NAME=cpu-llama
RUNPOD_POD_COUNT=1

# Pod creation via scripts/runpod_manage.py
RUNPOD_IMAGE_NAME=ghcr.io/<OWNER>/<REPO>:latest
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_COMPUTE_TYPE=CPU
# Replace with exact CPU flavor IDs from the RunPod UI
RUNPOD_CPU_FLAVORS=REPLACE_ME
RUNPOD_CPU_FLAVOR_FALLBACKS=
RUNPOD_CPU_FLAVOR_PRIORITY=
RUNPOD_PORTS=8000/http
RUNPOD_DATA_CENTER_IDS=
RUNPOD_VOLUME_MOUNT_PATH=/models
RUNPOD_VOLUME_SIZE_GB=200
RUNPOD_CONTAINER_DISK_GB=50
RUNPOD_NETWORK_VOLUME_NAME=llama-cache
RUNPOD_NETWORK_VOLUME_SIZE_GB=500
RUNPOD_NETWORK_VOLUME_DATA_CENTER_ID=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_CONTAINER_ENV_KEYS=MODEL_PATH,MODEL_URL,HOST,PORT,LLAMA_CTX,LLAMA_THREADS,LLAMA_MLOCK,LLAMA_NO_MMAP,LLAMA_EXTRA_ARGS,HF_TOKEN
RUNPOD_RETRY_ATTEMPTS=3
RUNPOD_RETRY_DELAY_SEC=60
RUNPOD_ALLOW_ANY_DATACENTER_ON_FAILURE=false
RUNPOD_FALLBACK_ENABLED=true
