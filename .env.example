# Example environment variables (do not put secrets in git)
VLLM_BASE_URL=https://YOUR-RUNPOD-ENDPOINT/v1
VLLM_API_KEY=local-key
MODEL_ID=MiniMaxAI/MiniMax-M2.1
SERVED_MODEL_NAME=MiniMaxAI/MiniMax-M2.1
HF_TOKEN=REPLACE_ME
HF_HOME=/workspace/hf
HUGGINGFACE_HUB_CACHE=/workspace/hf/hub
TRANSFORMERS_CACHE=/workspace/hf/transformers
VLLM_CACHE=/workspace/vllm-cache

# RunPod API
RUNPOD_API_KEY=REPLACE_ME
RUNPOD_API_BASE=https://rest.runpod.io/v1
RUNPOD_POD_NAME=minimax-vllm
POD_INSTANCES=1
RUNPOD_POD_COUNT=1

# If you already have a public endpoint host, set this to skip API lookup
RUNPOD_ENDPOINT_HOST=your-endpoint-host

# Pod creation via scripts/runpod_manage.py
RUNPOD_IMAGE_NAME=ghcr.io/<OWNER>/<REPO>:latest
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_COMPUTE_TYPE=GPU
RUNPOD_GPU_TYPE=NVIDIA H100 80GB HBM3
RUNPOD_GPU_COUNT=8
RUNPOD_PORTS=8000/http
RUNPOD_DATA_CENTER_IDS=US-CA-2
RUNPOD_INTERRUPTIBLE=false
RUNPOD_VOLUME_SIZE_GB=200
RUNPOD_VOLUME_MOUNT_PATH=/workspace
RUNPOD_CONTAINER_DISK_GB=50
RUNPOD_NETWORK_VOLUME_NAME=minimax-cache
RUNPOD_NETWORK_VOLUME_SIZE_GB=500
RUNPOD_NETWORK_VOLUME_DATA_CENTER_ID=US-CA-2
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_CONTAINER_ENV_KEYS=MODEL_ID,SERVED_MODEL_NAME,TP_SIZE,HF_TOKEN,VLLM_API_KEY,HF_HOME,HUGGINGFACE_HUB_CACHE,TRANSFORMERS_CACHE,VLLM_CACHE
RUNPOD_RETRY_ATTEMPTS=3
RUNPOD_RETRY_DELAY_SEC=60
RUNPOD_ALLOW_ANY_DATACENTER_ON_FAILURE=false
RUNPOD_FALLBACK_ENABLED=true
RUNPOD_GPU_TYPE_FALLBACKS=NVIDIA H100 80GB HBM3,NVIDIA A100-SXM4-80GB,NVIDIA H100 PCIe,NVIDIA A100 80GB PCIe
RUNPOD_GPU_COUNT_FALLBACKS=8,4,2,1

# Legacy aliases (optional)
GPU_TYPE=NVIDIA H100 80GB HBM3
GPU_COUNT=8
TP_SIZE=8
