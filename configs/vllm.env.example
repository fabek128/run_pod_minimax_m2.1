# Core model settings
MODEL_ID=MiniMaxAI/MiniMax-M2.1
SERVED_MODEL_NAME=MiniMaxAI/MiniMax-M2.1
TP_SIZE=8

# Performance tuning
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=32768

# RunPod provisioning (informational; set in RunPod UI/API)
GPU_TYPE=H100-80GB
GPU_COUNT=8
POD_INSTANCES=1

# Security (optional but recommended when endpoint is public)
# VLLM_API_KEY=change-me

# Hugging Face auth and caching on persistent volume
HF_TOKEN=REPLACE_ME
PERSIST_DIR=/workspace
HF_HOME=/workspace/hf
HUGGINGFACE_HUB_CACHE=/workspace/hf/hub
TRANSFORMERS_CACHE=/workspace/hf/transformers
VLLM_CACHE=/workspace/vllm-cache

# Warmup (0 or 1)
WARMUP_DOWNLOAD=0
