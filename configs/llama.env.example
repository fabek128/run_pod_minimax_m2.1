# Model settings
MODEL_PATH=/models/model.gguf
# Optional direct download URL (supports HF_TOKEN auth)
MODEL_URL=

# Server
HOST=0.0.0.0
PORT=8000

# llama.cpp performance
LLAMA_CTX=8192
LLAMA_THREADS=32
LLAMA_MLOCK=1
LLAMA_NO_MMAP=0
LLAMA_EXTRA_ARGS=

# Optional (if your model URL needs HF auth)
HF_TOKEN=
